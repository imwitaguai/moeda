# Configure no painel da Netlify; nunca salve chaves reais neste arquivo.
# AWESOMEAPI_KEY é OPCIONAL — a API pública funciona sem chave (usada apenas se você tiver um plano com limites maiores).
AWESOMEAPI_KEY=adicione_a_chave_somente_na_netlify
OPENROUTER_API_KEY=adicione_a_chave_somente_na_netlify
OPENROUTER_MODEL=openai/gpt-4o-mini
SITE_URL=https://seu-site.netlify.app
SITE_NAME=Clube das Moedas
